ight:15px\"><use href=\"#lu-terminal\"/></svg></span><span class=\"st-ic\" title=\"file\"><svg class=\"i\" style=\"width:15px;height:15px\"><use href=\"#lu-file\"/></svg></span><span class=\"st-ic\" title=\"copy\"><svg class=\"i\" style=\"width:15px;height:15px\"><use href=\"#lu-copy\"/></svg></span><span class=\"st-ic\" title=\"external-link\"><svg class=\"i\" style=\"width:15px;height:15px\"><use href=\"#lu-external-link\"/></svg></span><span class=\"st-ic\" title=\"eye-off\"><svg class=\"i\" style=\"width:15px;height:15px\"><use href=\"#lu-eye-off\"/></svg></span><span class=\"st-ic\" title=\"bot\"><svg class=\"i\" style=\"width:15px;height:15px\"><use href=\"#lu-bot\"/></svg></span><span class=\"st-ic\" title=\"chevron-right\"><svg class=\"i\" style=\"width:15px;height:15px\"><use href=\"#lu-chevron-right\"/></svg></span><span class=\"st-ic\" title=\"grip-vertical\"><svg class=\"i\" style=\"width:15px;height:15px\"><use href=\"#lu-grip-vertical\"/></svg></span></div></div></div>"
