{
 "LucideFourSizes": {
  "caption": "12 inline · 14 row · 15 control · 17 chrome. Exact Lucide, stroke as drawn.",
  "html": "<div class=\"kanso-story\"><div class=\"kanso-story__theme kanso-story__frame kanso-story--free\"><div class=\"kanso-story__row\"><svg class=\"kanso-icon\" style=\"width:12px;height:12px\"><use href=\"#lu-file\"/></svg><svg class=\"kanso-icon\" style=\"width:14px;height:14px\"><use href=\"#lu-file\"/></svg><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-file\"/></svg><svg class=\"kanso-icon\" style=\"width:17px;height:17px\"><use href=\"#lu-file\"/></svg></div></div></div>"
 },
 "TheSet": {
  "caption": "One icon per meaning, used the same everywhere.",
  "html": "<div class=\"kanso-story\"><div class=\"kanso-story__theme kanso-story__frame kanso-story--free\"><div class=\"kanso-story__row kanso-story--wrap\"><span class=\"kanso-story__icon\" title=\"plus\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-plus\"/></svg></span><span class=\"kanso-story__icon\" title=\"search\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-search\"/></svg></span><span class=\"kanso-story__icon\" title=\"arrow-up-down\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-arrow-up-down\"/></svg></span><span class=\"kanso-story__icon\" title=\"panel-left\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-panel-left\"/></svg></span><span class=\"kanso-story__icon\" title=\"settings\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-settings\"/></svg></span><span class=\"kanso-story__icon\" title=\"refresh-cw\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-refresh-cw\"/></svg></span><span class=\"kanso-story__icon\" title=\"git-branch\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-git-branch\"/></svg></span><span class=\"kanso-story__icon\" title=\"git-pull-request\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-git-pull-request\"/></svg></span><span class=\"kanso-story__icon\" title=\"moon\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-moon\"/></svg></span><span class=\"kanso-story__icon\" title=\"send\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-send\"/></svg></span><span class=\"kanso-story__icon\" title=\"x\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-x\"/></svg></span><span class=\"kanso-story__icon\" title=\"power\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-power\"/></svg></span><span class=\"kanso-story__icon\" title=\"monitor\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-monitor\"/></svg></span><span class=\"kanso-story__icon\" title=\"server\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-server\"/></svg></span><span class=\"kanso-story__icon\" title=\"terminal\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-terminal\"/></svg></span><span class=\"kanso-story__icon\" title=\"file\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-file\"/></svg></span><span class=\"kanso-story__icon\" title=\"copy\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-copy\"/></svg></span><span class=\"kanso-story__icon\" title=\"external-link\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-external-link\"/></svg></span><span class=\"kanso-story__icon\" title=\"eye-off\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-eye-off\"/></svg></span><span class=\"kanso-story__icon\" title=\"bot\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-bot\"/></svg></span><span class=\"kanso-story__icon\" title=\"chevron-right\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-chevron-right\"/></svg></span><span class=\"kanso-story__icon\" title=\"grip-vertical\"><svg class=\"kanso-icon\" style=\"width:15px;height:15px\"><use href=\"#lu-grip-vertical\"/></svg></span></div></div></div>"
 },
 "ProgramMarks": {
  "caption": "A program is its mark at 100%: Claude, Codex, a plain terminal. 15 on a row.",
  "html": "<div class=\"kanso-story\"><div class=\"kanso-story__theme kanso-story__frame kanso-story--free\"><div class=\"kanso-story__row\"><svg class=\"kanso-icon--program\" style=\"width:15px;height:15px\"><use href=\"#p-claude\"/></svg><svg class=\"kanso-icon--program\" style=\"width:15px;height:15px\"><use href=\"#p-codex\"/></svg><svg class=\"kanso-icon kanso-icon--control\"><use href=\"#lu-terminal\"/></svg></div></div></div>"
 },
 "EnsoMarks": {
  "caption": "Working spins, idle is the open ring, done the full ring, blocked the mark that asks. 14 on a row.",
  "html": "<div class=\"kanso-story\"><div class=\"kanso-story__theme kanso-story__frame kanso-story--free\"><div class=\"kanso-story__row\"><span class=\"kanso-story__icon\"><svg class=\"kanso-mark kanso-mark--working\"><use href=\"#e-work\"/></svg></span><span class=\"kanso-story__icon\"><svg class=\"kanso-mark kanso-mark--idle\"><use href=\"#e-idle\"/></svg></span><span class=\"kanso-story__icon\"><svg class=\"kanso-mark kanso-mark--done\"><use href=\"#e-done\"/></svg></span><span class=\"kanso-story__icon\"><svg class=\"kanso-mark kanso-mark--blocked\"><use href=\"#e-blk\"/></svg></span></div></div></div>"
 },
 "PendingDotAndGlint": {
  "caption": "Pending = 80% plus one breathing dot. A working name shimmers; nothing else moves.",
  "html": "<div class=\"kanso-story\"><div class=\"kanso-story__theme kanso-story__frame kanso-story--free\"><div class=\"kanso-story__row\"><span class=\"kanso-state-line--pending\" style=\"display:flex;align-items:center;gap:var(--k-sp-2)\"><span class=\"kanso-state-line__pending-dot\"></span><span style=\"color:var(--muted);font-size:var(--k-fs-meta)\">now</span></span><span class=\"kanso-text--glint\" style=\"font-size:var(--k-fs-name);font-weight:var(--k-fw-medium)\">Kylo-ren</span><span class=\"kanso-skeleton kanso-skeleton--breathing\" style=\"width:120px;height:8px\"></span></div></div></div>"
 },
 "TheWholeSet": {
  "caption": "I1: every icon in use, its Lucide name and what it means. Nothing outside this list.",
  "html": "<div class=\"kanso-story\"><div class=\"kanso-story__frame kanso-story--wide\"><div class=\"kanso-story--board\">\n    <div class=\"kanso-story__scroll\">\n      <div class=\"kanso-story__theme kanso-story__layout-column\" style=\"width:max-content;gap:var(--k-sp-4)\">\n        <div class=\"kanso-icon__examples\">\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-activity\"/></svg><div><div class=\"kanso-icon__name\">lu-activity</div><div class=\"kanso-icon__description\">activity, running</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-apple\"/></svg><div><div class=\"kanso-icon__name\">lu-apple</div><div class=\"kanso-icon__description\">iOS (flag: no brand marks in Lucide)</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-arrow-right-left\"/></svg><div><div class=\"kanso-icon__name\">lu-arrow-right-left</div><div class=\"kanso-icon__description\">sync</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-arrow-up-down\"/></svg><div><div class=\"kanso-icon__name\">lu-arrow-up-down</div><div class=\"kanso-icon__description\">sort</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-bot\"/></svg><div><div class=\"kanso-icon__name\">lu-bot</div><div class=\"kanso-icon__description\">an agent, Explain to &lt;agent&gt;</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-chart-column\"/></svg><div><div class=\"kanso-icon__name\">lu-chart-column</div><div class=\"kanso-icon__description\">Spend</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-check\"/></svg><div><div class=\"kanso-icon__name\">lu-check</div><div class=\"kanso-icon__description\">checked, on</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-chevron-down\"/></svg><div><div class=\"kanso-icon__name\">lu-chevron-down</div><div class=\"kanso-icon__description\">fold open, next</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-chevron-left\"/></svg><div><div class=\"kanso-icon__name\">lu-chevron-left</div><div class=\"kanso-icon__description\">back</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-chevron-right\"/></svg><div><div class=\"kanso-icon__name\">lu-chevron-right</div><div class=\"kanso-icon__description\">folded, go in</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-chevron-up\"/></svg><div><div class=\"kanso-icon__name\">lu-chevron-up</div><div class=\"kanso-icon__description\">previous</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-circle-question-mark\"/></svg><div><div class=\"kanso-icon__name\">lu-circle-question-mark</div><div class=\"kanso-icon__description\">help, keys</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-clock\"/></svg><div><div class=\"kanso-icon__name\">lu-clock</div><div class=\"kanso-icon__description\">time, scheduled</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-code\"/></svg><div><div class=\"kanso-icon__name\">lu-code</div><div class=\"kanso-icon__description\">code, source</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-columns-2\"/></svg><div><div class=\"kanso-icon__name\">lu-columns-2</div><div class=\"kanso-icon__description\">split right</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-container\"/></svg><div><div class=\"kanso-icon__name\">lu-container</div><div class=\"kanso-icon__description\">containers</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-copy\"/></svg><div><div class=\"kanso-icon__name\">lu-copy</div><div class=\"kanso-icon__description\">copy</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-download\"/></svg><div><div class=\"kanso-icon__name\">lu-download</div><div class=\"kanso-icon__description\">update kansō</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-ellipsis\"/></svg><div><div class=\"kanso-icon__name\">lu-ellipsis</div><div class=\"kanso-icon__description\">more actions</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-external-link\"/></svg><div><div class=\"kanso-icon__name\">lu-external-link</div><div class=\"kanso-icon__description\">open outside</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-eye\"/></svg><div><div class=\"kanso-icon__name\">lu-eye</div><div class=\"kanso-icon__description\">Images, show</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-eye-off\"/></svg><div><div class=\"kanso-icon__name\">lu-eye-off</div><div class=\"kanso-icon__description\">hide this</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-file\"/></svg><div><div class=\"kanso-icon__name\">lu-file</div><div class=\"kanso-icon__description\">file, Files panel</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-folder\"/></svg><div><div class=\"kanso-icon__name\">lu-folder</div><div class=\"kanso-icon__description\">folder, project</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-folder-plus\"/></svg><div><div class=\"kanso-icon__name\">lu-folder-plus</div><div class=\"kanso-icon__description\">new project</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-git-branch\"/></svg><div><div class=\"kanso-icon__name\">lu-git-branch</div><div class=\"kanso-icon__description\">branch</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-git-fork\"/></svg><div><div class=\"kanso-icon__name\">lu-git-fork</div><div class=\"kanso-icon__description\">worktree</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-git-pull-request\"/></svg><div><div class=\"kanso-icon__name\">lu-git-pull-request</div><div class=\"kanso-icon__description\">pull request</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-grip-vertical\"/></svg><div><div class=\"kanso-icon__name\">lu-grip-vertical</div><div class=\"kanso-icon__description\">drag handle</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-house\"/></svg><div><div class=\"kanso-icon__name\">lu-house</div><div class=\"kanso-icon__description\">home</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-image\"/></svg><div><div class=\"kanso-icon__name\">lu-image</div><div class=\"kanso-icon__description\">image</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-key\"/></svg><div><div class=\"kanso-icon__name\">lu-key</div><div class=\"kanso-icon__description\">key, sign in</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-keyboard\"/></svg><div><div class=\"kanso-icon__name\">lu-keyboard</div><div class=\"kanso-icon__description\">software keyboard (Simulator)</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-layers\"/></svg><div><div class=\"kanso-icon__name\">lu-layers</div><div class=\"kanso-icon__description\">layers, arrangement set</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-link\"/></svg><div><div class=\"kanso-icon__name\">lu-link</div><div class=\"kanso-icon__description\">linked again</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-lock\"/></svg><div><div class=\"kanso-icon__name\">lu-lock</div><div class=\"kanso-icon__description\">lock</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-map-pin\"/></svg><div><div class=\"kanso-icon__name\">lu-map-pin</div><div class=\"kanso-icon__description\">location</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-memory-stick\"/></svg><div><div class=\"kanso-icon__name\">lu-memory-stick</div><div class=\"kanso-icon__description\">memory</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-message-square\"/></svg><div><div class=\"kanso-icon__name\">lu-message-square</div><div class=\"kanso-icon__description\">thread, message</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-minus\"/></svg><div><div class=\"kanso-icon__name\">lu-minus</div><div class=\"kanso-icon__description\">minimize</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-monitor\"/></svg><div><div class=\"kanso-icon__name\">lu-monitor</div><div class=\"kanso-icon__description\">this computer</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-moon\"/></svg><div><div class=\"kanso-icon__name\">lu-moon</div><div class=\"kanso-icon__description\">asleep, sleep</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-move-horizontal\"/></svg><div><div class=\"kanso-icon__name\">lu-move-horizontal</div><div class=\"kanso-icon__description\">wider or narrower</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-panel-left\"/></svg><div><div class=\"kanso-icon__name\">lu-panel-left</div><div class=\"kanso-icon__description\">fold the sidebar</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-panels-top-left\"/></svg><div><div class=\"kanso-icon__name\">lu-panels-top-left</div><div class=\"kanso-icon__description\">Arrangements</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-pencil\"/></svg><div><div class=\"kanso-icon__name\">lu-pencil</div><div class=\"kanso-icon__description\">rename</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-pin\"/></svg><div><div class=\"kanso-icon__name\">lu-pin</div><div class=\"kanso-icon__description\">pinned</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-plug\"/></svg><div><div class=\"kanso-icon__name\">lu-plug</div><div class=\"kanso-icon__description\">ports, servers</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-plus\"/></svg><div><div class=\"kanso-icon__name\">lu-plus</div><div class=\"kanso-icon__description\">add, new</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-power\"/></svg><div><div class=\"kanso-icon__name\">lu-power</div><div class=\"kanso-icon__description\">off, power</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-refresh-cw\"/></svg><div><div class=\"kanso-icon__name\">lu-refresh-cw</div><div class=\"kanso-icon__description\">refresh</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-rotate-ccw\"/></svg><div><div class=\"kanso-icon__name\">lu-rotate-ccw</div><div class=\"kanso-icon__description\">rotate</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-rows-2\"/></svg><div><div class=\"kanso-icon__name\">lu-rows-2</div><div class=\"kanso-icon__description\">split down</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-search\"/></svg><div><div class=\"kanso-icon__name\">lu-search</div><div class=\"kanso-icon__description\">find</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-send\"/></svg><div><div class=\"kanso-icon__name\">lu-send</div><div class=\"kanso-icon__description\">send to an agent</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-server\"/></svg><div><div class=\"kanso-icon__name\">lu-server</div><div class=\"kanso-icon__description\">another computer</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-settings\"/></svg><div><div class=\"kanso-icon__name\">lu-settings</div><div class=\"kanso-icon__description\">settings</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-share\"/></svg><div><div class=\"kanso-icon__name\">lu-share</div><div class=\"kanso-icon__description\">share</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-sliders-vertical\"/></svg><div><div class=\"kanso-icon__name\">lu-sliders-vertical</div><div class=\"kanso-icon__description\">settings for this</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-smartphone\"/></svg><div><div class=\"kanso-icon__name\">lu-smartphone</div><div class=\"kanso-icon__description\">Simulator</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-square\"/></svg><div><div class=\"kanso-icon__name\">lu-square</div><div class=\"kanso-icon__description\">maximize</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-sun\"/></svg><div><div class=\"kanso-icon__name\">lu-sun</div><div class=\"kanso-icon__description\">awake, light</div></div></div>\n          <div class=\"kanso-icon__example\"><svg class=\"kanso-icon kanso-icon--chrome\"><use href=\"#lu-terminal\"/></svg><div><div class=\"kanso-icon__name\">lu-terminal</div><div class=\"kanso-icon__description\">terminal, a shell</div></div></div>\n 