ass=\"kanso-tab--panel\" tabindex=\"0\"><svg class=\"kanso-icon\"><use href=\"#lu-chart-column\"/></svg></span><span class=\"kanso-tab--panel kanso-control--on\" tabindex=\"0\"><svg class=\"kanso-icon\"><use href=\"#lu-git-pull-request\"/></svg></span><span class=\"kanso-tab--panel\" tabindex=\"0\"><svg class=\"kanso-icon\"><use href=\"#lu-trophy\"/></svg></span><span class=\"kanso-tab--panel\" tabindex=\"0\"><svg class=\"kanso-icon\"><use href=\"#lu-git-fork\"/></svg></span><span class=\"kanso-tab--panel\" tabindex=\"0\"><svg class=\"kanso-icon\"><use href=\"#lu-memory-stick\"/></svg></span><span class=\"kanso-tab--panel\" tabindex=\"0\"><svg class=\"kanso-icon\"><use href=\"#lu-eye\"/></svg></span>\n            </div>\n            <div class=\"kanso-tab-bar kanso-story__bars-frame\" style=\"width:560px\">\n              <span class=\"kanso-tab kanso-control--on\" tabindex=\"0\"><span class=\"kanso-text--truncate\" style=\"max-width:72px\">checkout</span><svg class=\"kanso-icon kanso-icon--narrow kanso-text--dim\"><use href=\"#lu-x\"/></svg></span>\n              <span class=\"kanso-tab--panel kanso-tab__name kanso-status-bar__item--offset\" tabindex=\"0\">+4</span>\n              <span class=\"kanso-tab--panel kanso-status-bar__item--offset\" tabindex=\"0\"><svg class=\"kanso-icon\"><use href=\"#lu-plus\"/></svg></span><span class=\"kanso-tab--panel kanso-status-bar__item--offset\" tabindex=\"0\"><svg class=\"kanso-icon\"><use href=\"#lu-panels-top-left\"/></svg></span>\n              <span class=\"kanso-layout__grow\"></span>\n              <span class=\"kanso-tab--panel\" tabindex=\"0\"><svg class=\"kanso-icon\"><use href=\"#lu-file\"/></svg></span><span class=\"kanso-tab--panel\" tabindex=\"0\"><svg class=\"kanso-icon\"><use href=\"#lu-plug\"/></svg></span><span class=\"kanso-tab--panel\" tabindex=\"0\"><svg class=\"kanso-icon\"><use href=\"#lu-chart-column\"/></svg></span><span class=\"kanso-tab--panel kanso-control--on\" tabindex=\"0\"><svg class=\"kanso-icon