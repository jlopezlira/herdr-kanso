div class=\"icx-m\">find</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-send\"/></svg><div><div class=\"icx-n\">lu-send</div><div class=\"icx-m\">send to an agent</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-server\"/></svg><div><div class=\"icx-n\">lu-server</div><div class=\"icx-m\">another computer</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-settings\"/></svg><div><div class=\"icx-n\">lu-settings</div><div class=\"icx-m\">settings</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-share\"/></svg><div><div class=\"icx-n\">lu-share</div><div class=\"icx-m\">share</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-sliders-vertical\"/></svg><div><div class=\"icx-n\">lu-sliders-vertical</div><div class=\"icx-m\">settings for this</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-smartphone\"/></svg><div><div class=\"icx-n\">lu-smartphone</div><div class=\"icx-m\">Simulator</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-square\"/></svg><div><div class=\"icx-n\">lu-square</div><div class=\"icx-m\">maximize</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-sun\"/></svg><div><div class=\"icx-n\">lu-sun</div><div class=\"icx-m\">awake, light</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-terminal\"/></svg><div><div class=\"icx-n\">lu-terminal</div><div class=\"icx-m\">terminal, a shell</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-trophy\"/></svg><div><div class=\"icx-n\">lu-trophy</div><div class=\"icx-m\">Shipped</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-undo\"/></svg><div><div class=\"icx-n\">lu-undo</div><div class=\"icx-m\">undo</div></div