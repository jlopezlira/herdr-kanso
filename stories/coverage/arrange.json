        "html": "<div class=\"kanso-story\"><div class=\"kanso-story__theme kanso-story__frame\" style=\"max-width:100%\"><div class=\"kanso-sidebar__dialog\" style=\"max-width:100%\"><div class=\"kanso-sidebar__dialog-title\">Arrangements</div><div class=\"kanso-row--two-lines kanso-row--selected\" tabindex=\"0\"><div class=\"kanso-content__primary\"><span class=\"kanso-story__ellipsis\">Web and api</span><span class=\"kanso-panel__row-value\"></span></div><div class=\"kanso-actions\"><button type=\"button\" style=\"border:0;font-family:inherit;cursor:pointer;background:transparent\" class=\"kanso-button--quiet\">Overwrite</button><button type=\"button\" style=\"border:0;font-family:inherit;cursor:pointer\" class=\"kanso-button--quiet kanso-action kanso-action--armed\"><span>Delete</span><span>Press again to delete</span></button></div></div></div></div></div>",
