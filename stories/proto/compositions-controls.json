  "html": "<div class=\"kanso-story\"><div class=\"kanso-story__theme kanso-story__frame kanso-story--free\"><div class=\"kanso-actions\" style=\"margin:0\"><span class=\"kanso-button\" tabindex=\"0\">Merge</span><span class=\"kanso-button--tonal\" tabindex=\"0\">Refresh</span><span class=\"kanso-button--quiet kanso-text--foreground\" tabindex=\"0\">Cancel</span><span class=\"kanso-button--icon\" tabindex=\"0\"><svg class=\"kanso-icon\"><use href=\"#lu-external-link\"/></svg></span><span class=\"kanso-button kanso-control--off\" tabindex=\"0\">Merge</span><span class=\"kanso-button--icon kanso-button--off\" tabindex=\"0\"><svg class=\"kanso-icon\"><use href=\"#lu-chevron-right\"/></svg></span></div></div></div>"
