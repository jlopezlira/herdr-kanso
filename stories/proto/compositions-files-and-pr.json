 "Snippet": {
  "caption": "A review comment quotes three lines, the one it talks about on w7.",
  "html": "<div class=\"kanso-story\"><div class=\"kanso-story__theme kanso-story__frame kanso-panel\"><div class=\"kanso-panel\" style=\"height:auto\"><div class=\"kanso-review__snippet\"><div class=\"kanso-diff__line\"><span class=\"kanso-row__name\">11</span><span class=\"kanso-row__detail\"> </span>export function bucket(customer) {</div><div class=\"kanso-diff__line kanso-control--on\"><span class=\"kanso-row__name\">12</span><span class=\"kanso-row__detail\"> </span>  const plan = planOf(customer);</div><div class=\"kanso-diff__line\"><span class=\"kanso-row__name\">13</span><span class=\"kanso-row__detail\"> </span>  return { plan, tokens: LIMIT[plan] };</div></div></div></div></div>"
 },
