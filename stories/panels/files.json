n><span class=\"kanso-file__status kanso-text--dim\">A</span>limits.ts</div>\n              <div class=\"kanso-row\"><span style=\"width:44px;flex:none\"></span><svg class=\"kanso-icon kanso-icon--row kanso-text--muted\"><use href=\"#lu-file\"/></svg>plans.ts</div>\n              <div class=\"kanso-row\"><span style=\"width:16px;flex:none\"></span><svg class=\"kanso-icon kanso-icon--inline kanso-text--dim\"><use href=\"#lu-chevron-right\"/></svg><svg class=\"kanso-icon kanso-icon--row kanso-text--muted\"><use href=\"#lu-folder\"/></svg>web</div>\n              <div class=\"kanso-row\"><svg class=\"kanso-icon kanso-icon--inline kanso-text--dim\"><use href=\"#lu-chevron-down\"/></svg><svg class=\"kanso-icon kanso-icon--row kanso-text--muted\"><use href=\"#lu-folder\"/></svg>fixtures</div>\n              <div class=\"kanso-row\"><span style=\"width:28px;flex:none\"></span><svg class=\"kanso-icon kanso-icon--row kanso-text--muted\"><use href=\"#lu-file\"/></svg>orders-0001.json</div>\n              <div class=\"kanso-row kanso-panel__more\"><span style=\"width:28px;flex:none\"></span>1,214 more not listed</div>\n              <div class=\"kanso-row\"><span style=\"width:12px;flex:none\"></span><svg class=\"kanso-icon kanso-icon--row kanso-text--muted\"><use href=\"#lu-file\"/></svg>package.json</div>\n            </div></div></div>",
