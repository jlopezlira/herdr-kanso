{
  "SleepDialog": {
    "caption": "When sleeping a project, tab or agent, only work that will not return is called out; Seijaku keeps this component and its states in the shared kit.",
    "variants": {
      "Project": {
        "when": "The whole project is being put away.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbx-dlg\" style=\"max-width:100%\"><div class=\"sbx-dt\">Sleep acme</div><div class=\"prow2\" tabindex=\"0\"><div class=\"a\"><span class=\"st-ell\">npm run dev</span><span class=\"pbx-v\"></span></div><div class=\"p-scope\">will stop now</div></div><div class=\"acts\"><button type=\"button\" style=\"border:0;font-family:inherit;cursor:pointer\" class=\"btn\">Sleep</button></div></div></div></div>",
        "source": "kanso/mods/kanso-sleep/main.js:181"
      },
      "Tab": {
        "when": "A tab is being put away.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbx-dlg\" style=\"max-width:100%\"><div class=\"sbx-dt\">Sleep this tab</div><div class=\"prow2\" tabindex=\"0\"><div class=\"a\"><span class=\"st-ell\">npm run dev</span><span class=\"pbx-v\"></span></div><div class=\"p-scope\">will stop now</div></div><div class=\"acts\"><button type=\"button\" style=\"border:0;font-family:inherit;cursor:pointer\" class=\"btn\">Sleep</button></div></div></div></div>",
        "source": "kanso/mods/kanso-sleep/main.js:181"
      },
      "Agent": {
        "when": "One agent is being put away.",
