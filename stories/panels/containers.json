 "ContainersRestOneExitedTwoRunningOneProjectNotStarted": {
  "name": "Containers, Rest: one exited, two running, one project not started",
  "caption": "Rest: one exited, two running, one project not started.",
  "html": "<div class=\"kanso-story\"><div class=\"kanso-story__theme kanso-story__frame kanso-panel\"><div class=\"kanso-panel\"><div class=\"kanso-panel__header\"><span class=\"kanso-panel__title\">Containers</span><span class=\"kanso-button--icon\"><svg class=\"kanso-icon\"><use href=\"#lu-refresh-cw\"/></svg></span></div><div class=\"kanso-panel__metric\"><span class=\"kanso-panel__metric-number\">2.1 GB</span><span class=\"kanso-metric__unit\">held</span><span class=\"kanso-button--quiet\" style=\"margin-left:auto\">Quit Docker (stops 2)</span></div><div class=\"kanso-section\">acme-shop<span class=\"kanso-button--quiet\" style=\"margin-left:auto\">Stop all</span></div><div class=\"kanso-row kanso-panel__compact-row\"><span>compose.yaml</span><span class=\"kanso-text--dim\" style=\"font-size:var(--k-fs-meta)\">2 of 3 up</span><span class=\"kanso-layout__grow\"></span><span class=\"kanso-button--quiet kanso-text--foreground\">Up again</span><span class=\"kanso-button--quiet\">Rebuild</span><span class=\"kanso-button--quiet\">Down</span></div><div class=\"kanso-row--two-lines\"><div class=\"kanso-content__primary kanso-panel__compact-row\"><svg class=\"kanso-mark kanso-mark--blocked kanso-mark--small\"><use href=\"#e-blk\"/></svg><span>api-db</span><span class=\"kanso-panel__row-value kanso-text--blocked\">exited 1 · 3 min</span></div><div class=\"kanso-content__actions kanso-panel__actions\"><span class=\"kanso-button--quiet\">Start</span><span class=\"kanso-button--quiet\">Logs</span><span class=\"kanso-button--quiet\">Details</span><span class=\"kanso-button--quiet\">Remove</span></div></div><div class=\"kanso-row--two-lines\"><div class=\"kanso-content__primary kanso-panel__compact-row\"><span>mailpit</span><span class=\"kanso-panel__row-value\">31 MB</span></div><div class=\"kanso-content__actions kanso-panel__actions\"><span class=\"kanso-button--quiet\">Stop</span><span class=\"kanso-button--quiet\">Restart</span><span class=\"kanso-button--quiet\">Open</span><span class=\"kanso-button--quiet\">Shell</span><span class=\"kanso-button--quiet\">Logs</span><span class=\"kanso-button--quiet\">Details</span></div></div><div class=\"kanso-row--two-lines\"><div class=\"kanso-content__primary kanso-panel__compact-row\"><span>redis</span><span class=\"kanso-panel__row-value\">9 MB</span></div><div class=\"kanso-content__actions kanso-panel__actions\"><span class=\"kanso-button--quiet\">Stop</span><span class=\"kanso-button--quiet\">Restart</span><span class=\"kanso-button--quiet\">Shell</span><span class=\"kanso-button--quiet\">Logs</span><span class=\"kanso-button--quiet\">Details</span></div></div><div class=\"kanso-section\">docs-site</div><div class=\"kanso-row kanso-panel__compact-row\"><span>compose.yaml</span><span class=\"kanso-text--dim\" style=\"font-size:var(--k-fs-meta)\">not started</span><span class=\"kanso-layout__grow\"></span><span class=\"kanso-button--quiet kanso-text--foreground\">Up</span><span class=\"kanso-button--quiet\">Rebuild</span></div><div class=\"kanso-section--collapsible kanso-panel__triple\"><span><svg class=\"kanso-icon kanso-icon--inline\"><use href=\"#lu-chevron-right\"/></svg>Images</span><span><svg class=\"kanso-icon kanso-icon--inline\"><use href=\"#lu-chevron-right\"/></svg>Volumes</span><span><svg class=\"kanso-icon kanso-icon--inline\"><use href=\"#lu-chevron-right\"/></svg>Build cache</span></div></div></div></div>",
