        "source": "kanso/mods/kanso-arrange/main.js:176"
      },
      "Overwrite": {
        "when": "The typed name already exists.",
        "html": "<div class=\"kanso-story\"><div class=\"kanso-story__theme kanso-story__frame\" style=\"max-width:100%\"><div class=\"kanso-sidebar__dialog\" style=\"max-width:100%\"><div class=\"kanso-sidebar__dialog-title\">Save this tab</div><div class=\"kanso-field\"><div class=\"kanso-prototype__text\" role=\"textbox\" aria-label=\"Name\" aria-multiline=\"false\" contenteditable=\"true\" tabindex=\"0\" style=\"outline:none;white-space:pre-wrap;min-height:var(--k-h-compact)\">Web and api</div></div><div class=\"kanso-segmented\" role=\"group\" aria-label=\"View\"><span role=\"button\" tabindex=\"0\" class=\"kanso-control--on\" aria-pressed=\"true\">web</span><span role=\"button\" tabindex=\"0\" class=\"\" aria-pressed=\"false\">api</span></div><div class=\"kanso-actions\"><button type=\"button\" style=\"border:0;font-family:inherit;cursor:pointer\" class=\"kanso-button kanso-action kanso-action--armed\"><span>Overwrite web and api</span><span>Press again to overwrite web and api</span></button></div></div></div></div>",
