        "source": "kanso/mods/kanso-sleep/main.js:181"
      },
      "Reading": {
        "when": "Conversations are being checked.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbx-dlg\" style=\"max-width:100%\"><div class=\"sbx-dt\">Sleep acme</div><div class=\"kit-skl skw\" aria-label=\"Loading\" role=\"status\"><div class=\"prow\"><span class=\"sk\" style=\"width:calc(var(--k-h-control) * 5);height:var(--k-sp-2)\"></span></div><div class=\"prow\"><span class=\"sk\" style=\"width:calc(var(--k-h-control) * 5);height:var(--k-sp-2)\"></span></div><div class=\"prow\"><span class=\"sk\" style=\"width:calc(var(--k-h-control) * 5);height:var(--k-sp-2)\"></span></div></div></div></div></div>",
        "source": "kanso/mods/kanso-sleep/main.js:181"
      },
      "Sleeping": {
        "when": "The processes are exiting.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbx-dlg\" style=\"max-width:100%\"><div class=\"sbx-dt\">Sleep acme</div><div class=\"prow2 kst-pend\" tabindex=\"0\"><div class=\"a\"><span class=\"st-ell\">checkout</span><span class=\"pbx-v\">Going to sleep</span><span class=\"kst-pdot\"></span></div></div></div></div></div>",
        "source": "kanso/mods/kanso-sleep/main.js:181"
      },
      "Blocked": {
        "when": "A running agent needs the user.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbx-dlg\" style=\"max-width:100%\"><div class=\"sbx-dt\">Sleep acme</div><div class=\"kst-line\" style=\"color:var(--blocked)\"><svg class=\"m m-blk\" aria-hidden=\"true\"><use href=\"#e-blk\"/></svg><span>checkout needs you first</span></div></div></div></div>",
        "source": "kanso/mods/kanso-sleep/main.js:181"
      },
      "Conversation absent": {
        "when": "The current conversation cannot be found.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbx-dlg\" style=\"max-width:100%\"><div class=\"sbx-dt\">Sleep acme</div><div class=\"kst-block\"><svg class=\"m m-blk\" aria-hidden=\"true\"><use href=\"#e-blk\"/></svg><div class=\"kst-what\">Cannot sleep checkout</div><div class=\"kst-why\" title=\"checkout’s conversation was not found\">checkout’s conversation was not found</div><div class=\"kst-acts\"><button type=\"button\" style=\"border:0;font-family:inherit;cursor:pointer\" class=\"btn\">Sleep</button><button type=\"button\" style=\"border:0;font-family:inherit;cursor:pointer\" class=\"kst-btn\">Explain to checkout</button></div></div></div></div></div>",
        "source": "kanso/mods/kanso-sleep/main.js:181"
      },
      "Not resumable": {
        "when": "The selected process cannot resume.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbx-dlg\" style=\"max-width:100%\"><div class=\"sbx-dt\">Sleep this agent</div><div class=\"kst-line\" style=\"color:var(--blocked)\"><svg class=\"m m-blk\" aria-hidden=\"true\"><use href=\"#e-blk\"/></svg><span>Only a resumable agent can sleep on its own</span></div></div></div></div>",
        "source": "kanso/mods/kanso-sleep/main.js:181"
      },
      "Nothing resumable": {
        "when": "No conversation can be restored.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbx-dlg\" style=\"max-width:100%\"><div class=\"sbx-dt\">Sleep acme</div><div class=\"kst-empty\"><svg class=\"i i14\" aria-hidden=\"true\"><use href=\"#lu-search\"/></svg><div class=\"t\">Nothing here keeps a conversation to wake on</div></div></div></div></div>",
        "source": "kanso/mods/kanso-sleep/main.js:181"
      },
      "Sleep failed": {
        "when": "An exit or label step failed.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbx-dlg\" style=\"max-width:100%\"><div class=\"sbx-dt\">Sleep acme</div><div class=\"kst-line\" style=\"color:var(--blocked)\"><svg class=\"m m-blk\" aria-hidden=\"true\"><use href=\"#e-blk\"/></svg><span>checkout did not exit</span><button type=\"button\" style=\"border:0;font-family:inherit;cursor:pointer\" class=\"kst-btn\">Undo</button></div></div></div></div>",
        "source": "kanso/mods/kanso-sleep/main.js:181"
      },
      "Waking": {
        "when": "A sleeping row is being restored.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbx-dlg\" style=\"max-width:100%\"><div class=\"sbx-dt\">Wake</div><div class=\"prow2 kst-pend\" tabindex=\"0\"><div class=\"a\"><span class=\"st-ell\">checkout</span><span class=\"pbx-v\">Waking…</span><span class=\"kst-pdot\"></span></div></div></div></div></div>",
        "source": "kanso/mods/kanso-sleep/main.js:181"
      },
      "Already awake": {
        "when": "The selected row is no longer asleep.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbx-dlg\" style=\"max-width:100%\"><div class=\"sbx-dt\">Wake</div><div class=\"kst-line\" style=\"color:var(--blocked)\"><svg class=\"m m-blk\" aria-hidden=\"true\"><use href=\"#e-blk\"/></svg><span>That is no longer asleep</span></div></div></div></div>",
        "source": "kanso/mods/kanso-sleep/main.js:181"
      }
    }
  }
}
