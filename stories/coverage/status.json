{
  "StatusStandIn": {
    "caption": "When status changes, the component shows the result in place; Seijaku keeps this component and its states in the shared kit.",
    "variants": {
      "Offscreen waiting": {
        "when": "A waiting agent’s home is outside the viewport.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbar\" style=\"max-width:100%\"><div class=\"kst-line\"><span>checkout · Choose the auth flow</span><button type=\"button\" style=\"border:0;font-family:inherit;cursor:pointer\" class=\"kst-btn\">Go to agent</button></div></div></div></div>",
        "source": "kanso/mods/kanso-status/main.js:73"
      },
      "Several waiting": {
        "when": "More than one offscreen agent needs input.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbar\" style=\"max-width:100%\"><div class=\"kst-line\"><span>checkout · Choose the auth flow · +2</span><button type=\"button\" style=\"border:0;font-family:inherit;cursor:pointer\" class=\"kst-btn\">Go to agent</button></div></div></div></div>",
        "source": "kanso/mods/kanso-status/main.js:73"
      },
      "Low memory": {
        "when": "Memory is low and its panel is closed.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbar\" style=\"max-width:100%\"><div class=\"kst-line\" style=\"color:var(--blocked)\"><svg class=\"m m-blk\" aria-hidden=\"true\"><use href=\"#e-blk\"/></svg><span>Memory low · 1.2 GB free</span><button type=\"button\" style=\"border:0;font-family:inherit;cursor:pointer\" class=\"kst-btn\">Open Memory</button></div></div></div></div>",
        "source": "kanso/mods/kanso-status/main.js:73"
      },
      "Visible home": {
        "when": "The responsible sidebar row or Memory panel is already visible.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbar\" style=\"max-width:100%\"><div class=\"p-scope\"></div></div></div></div>",
        "source": "kanso/mods/kanso-status/main.js:73"
      },
      "Quiet": {
        "when": "No offscreen fact needs attention.",
        "html": "<div class=\"st-ex\"><div class=\"k st-s\" style=\"max-width:100%\"><div class=\"sbar\" style=\"max-width:100%\"><div class=\"p-scope\"></div></div></div></div>",
        "source": "kanso/mods/kanso-status/main.js:73"
      }
    }
  }
}
