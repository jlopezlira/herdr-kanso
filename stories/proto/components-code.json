  "html": "<div class=\"kanso-story\"><div class=\"kanso-story__theme kanso-story__frame kanso-panel\"><div class=\"kanso-panel\" style=\"height:auto\"><div class=\"kanso-code\"><span class=\"kanso-row__name\">1</span><span class=\"kanso-text--violet\">import</span> { planOf } <span class=\"kanso-text--violet\">from</span> <span class=\"kanso-text--done\">\"./plans\"</span>;\n<span class=\"kanso-row__name\">2</span>\n<span class=\"kanso-row__name\">3</span><span class=\"kanso-text--violet\">const</span> LIMIT = { free: <span class=\"kanso-text--working\">40</span>, pro: <span class=\"kanso-text--working\">400</span> };\n<span class=\"kanso-row__name\">4</span><span class=\"kanso-text--violet\">const</span> REFILL_MS = <span class=\"kanso-text--working\">2000</span>;\n<span class=\"kanso-row__name\">5</span>\n<span class=\"kanso-row__name\">6</span><span class=\"kanso-text--violet\">export function</span> bucket(customer) {\n<span class=\"kanso-row__name\">7</span>  <span class=\"kanso-text--violet\">const</span> plan = planOf(customer);\n<span class=\"kanso-row__name\">8</span>  <span class=\"kanso-text--violet\">return</span> { plan, tokens: LIMIT[plan] };\n<span class=\"kanso-row__name\">9</span>}\n<span class=\"kanso-row__name\">10</span>\n<span class=\"kanso-row__name\">11</span><span class=\"kanso-text--violet\">export function</span> retryAfter(b) {\n<span class=\"kanso-row__name\">12</span>  <span class=\"kanso-text--violet\">const</span> missing = <span class=\"kanso-text--working\">1</span> - b.tokens;\n<span class=\"kanso-row__name\">13</span>  <span class=\"kanso-text--violet\">return</span> missing * REFILL_MS;\n<span class=\"kanso-row__name\">14</span>}</div><div class=\"kanso-diff\"><div class=\"kanso-diff__line\"><span class=\"kanso-row__name\">18</span><span class=\"kanso-row__detail\"> </span>const customer = req.user.id;</div><div class=\"kanso-diff__line kanso-diff__line--added\"><span class=\"kanso-row__name\">19</span><span class=\"kanso-row__detail\">+</span>const b = bucket(customer);</div><div class=\"kanso-diff__line kanso-diff__line--added\"><span class=\"kanso-row__name\">20</span><span class=\"kanso-row__detail\">+</span>if (b.tokens &lt; 1) {</div><div class=\"kanso-diff__line kanso-diff__line--added kanso-control--on\"><span class=\"kanso-row__name\"><span class=\"kanso-review__add\">+</span></span><span class=\"kanso-row__detail\">+</span>  res.set(\"Retry-After\", retryAfter(b));</div><div class=\"kanso-diff__line kanso-diff__line--added\"><span class=\"kanso-row__name\">22</span><span class=\"kanso-row__detail\">+</span>  return res.status(429).end();</div><div class=\"kanso-diff__line kanso-diff__line--added\"><span class=\"kanso-row__name\">23</span><span class=\"kanso-row__detail\">+</span>}</div></div></div></div></div>"
