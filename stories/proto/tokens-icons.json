 "TheWholeSet": {
  "caption": "I1: every icon in use, its Lucide name and what it means. Nothing outside this list.",
  "html": "<div class=\"st-ex\"><div class=\"st-s wide\"><div class=\"st-board\">\n    <div class=\"scroll\">\n      <div class=\"k col\" style=\"width:max-content;gap:var(--k-sp-4)\">\n        <div class=\"icx-grid\">\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-activity\"/></svg><div><div class=\"icx-n\">lu-activity</div><div class=\"icx-m\">activity, running</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-apple\"/></svg><div><div class=\"icx-n\">lu-apple</div><div class=\"icx-m\">iOS (flag: no brand marks in Lucide)</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-arrow-right-left\"/></svg><div><div class=\"icx-n\">lu-arrow-right-left</div><div class=\"icx-m\">sync</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-arrow-up-down\"/></svg><div><div class=\"icx-n\">lu-arrow-up-down</div><div class=\"icx-m\">sort</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-bot\"/></svg><div><div class=\"icx-n\">lu-bot</div><div class=\"icx-m\">an agent, Explain to &lt;agent&gt;</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-chart-column\"/></svg><div><div class=\"icx-n\">lu-chart-column</div><div class=\"icx-m\">Spend</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-check\"/></svg><div><div class=\"icx-n\">lu-check</div><div class=\"icx-m\">checked, on</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-chevron-down\"/></svg><div><div class=\"icx-n\">lu-chevron-down</div><div class=\"icx-m\">fold open, next</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-chevron-left\"/></svg><div><div class=\"icx-n\">lu-chevron-left</div><div class=\"icx-m\">back</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-chevron-right\"/></svg><div><div class=\"icx-n\">lu-chevron-right</div><div class=\"icx-m\">folded, go in</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-chevron-up\"/></svg><div><div class=\"icx-n\">lu-chevron-up</div><div class=\"icx-m\">previous</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-circle-question-mark\"/></svg><div><div class=\"icx-n\">lu-circle-question-mark</div><div class=\"icx-m\">help, keys</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-clock\"/></svg><div><div class=\"icx-n\">lu-clock</div><div class=\"icx-m\">time, scheduled</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-code\"/></svg><div><div class=\"icx-n\">lu-code</div><div class=\"icx-m\">code, source</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-columns-2\"/></svg><div><div class=\"icx-n\">lu-columns-2</div><div class=\"icx-m\">split right</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-container\"/></svg><div><div class=\"icx-n\">lu-container</div><div class=\"icx-m\">containers</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-copy\"/></svg><div><div class=\"icx-n\">lu-copy</div><div class=\"icx-m\">copy</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-download\"/></svg><div><div class=\"icx-n\">lu-download</div><div class=\"icx-m\">update kansō</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-ellipsis\"/></svg><div><div class=\"icx-n\">lu-ellipsis</div><div class=\"icx-m\">more actions</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-external-link\"/></svg><div><div class=\"icx-n\">lu-external-link</div><div class=\"icx-m\">open outside</div></div></div>\n          <div class=\"icx-c\"><svg class=\"i i17\"><use href=\"#lu-eye\"