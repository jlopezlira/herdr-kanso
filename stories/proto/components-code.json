  "html": "<div class=\"st-ex\"><div class=\"k st-s panel\"><div class=\"panel\" style=\"height:auto\"><div class=\"pax-code\"><span class=\"n\">1</span><span class=\"c-vio\">import</span> { planOf } <span class=\"c-vio\">from</span> <span class=\"c-done\">\"./plans\"</span>;\n<span class=\"n\">2</span>\n<span class=\"n\">3</span><span class=\"c-vio\">const</span> LIMIT = { free: <span class=\"c-work\">40</span>, pro: <span class=\"c-work\">400</span> };\n<span class=\"n\">4</span><span class=\"c-vio\">const</span> REFILL_MS = <span class=\"c-work\">2000</span>;\n<span class=\"n\">5</span>\n<span class=\"n\">6</span><span class=\"c-vio\">export function</span> bucket(customer) {\n<span class=\"n\">7</span>  <span class=\"c-vio\">const</span> plan = planOf(customer);\n<span class=\"n\">8</span>  <span class=\"c-vio\">return</span> { plan, tokens: LIMIT[plan] };\n<span class=\"n\">9</span>}\n<span class=\"n\">10</span>\n<span class=\"n\">11</span><span class=\"c-vio\">export function</span> retryAfter(b) {\n<span class=\"n\">12</span>  <span class=\"c-vio\">const</span> missing = <span class=\"c-work\">1</span> - b.tokens;\n<span class=\"n\">13</span>  <span class=\"c-vio\">return</span> missing * REFILL_MS;\n<span class=\"n\">14</span>}</div><div class=\"pax-diff\"><div class=\"pax-dl\"><span class=\"n\">18</span><span class=\"s\"> </span>const customer = req.user.id;</div><div class=\"pax-dl add\"><span class=\"n\">19</span><span class=\"s\">+</span>const b = bucket(customer);</div><div class=\"pax-dl add\"><span class=\"n\">20</span><span class=\"s\">+</span>if (b.tokens &lt; 1) {</div><div class=\"pax-dl add on\"><span class=\"n\"><span class=\"pax-plus\">+</span></span><span class=\"s\">+</span>  res.set(\"Retry-After\", retryAfter(b));</div><div class=\"pax-dl add\"><span class=\"n\">22</span><span class=\"s\">+</span>  return res.status(429).end();</div><div class=\"pax-dl add\"><span class=\"n\">23</span><span class=\"s\">+</span>}</div></div></div></div></div>"
