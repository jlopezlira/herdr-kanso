 "ContainersDiskOpenPullAnImagesRunFormVolumesBuildCache": {
  "name": "Containers, Disk open: pull, an image's Run form, volumes, build cache",
  "caption": "Disk open: pull, an image's Run form, volumes, build cache.",
  "html": "<div class=\"kanso-story\"><div class=\"kanso-story__theme kanso-story__frame kanso-panel\"><div class=\"kanso-panel\">\n              <div class=\"kanso-panel__header\"><span class=\"kanso-panel__title\">Containers</span><span class=\"kanso-button--icon\"><svg class=\"kanso-icon\"><use href=\"#lu-refresh-cw\"/></svg></span></div>\n              <div class=\"kanso-section--collapsible\" style=\"margin-top:var(--k-sp-4)\"><svg class=\"kanso-icon kanso-icon--inline\"><use href=\"#lu-chevron-down\"/></svg>Disk<span class=\"kanso-row__detail\">9 images 4.2 GB · 1.6 GB unused</span></div>\n              <div style=\"display:flex;gap:var(--k-sp-2);align-items:center;margin-top:var(--k-sp-4)\"><div class=\"kanso-field\" style=\"flex:1\">postgres:17</div><span class=\"kanso-button--quiet\" style=\"color:var(--input)\">Pull</span></div>\n              <div class=\"kanso-section\">Images<span class=\"kanso-button--quiet\">Remove unused · 1.6 GB</span></div>\n              <div class=\"kanso-row--two-lines\"><div class=\"kanso-content__primary kanso-panel__compact-row\"><span>postgres:16</span><span class=\"kanso-panel__row-value\">438 MB</span></div><div class=\"kanso-content__actions kanso-panel__actions\"><span class=\"kanso-button--quiet\">Stop</span><span class=\"kanso-button--quiet\">Restart</span><span class=\"kanso-button--quiet\">Shell</span><span class=\"kanso-button--quiet\">Logs</span><span class=\"kanso-button--quiet\">Details</span></div></div>\n              <div class=\"kanso-row--two-lines kanso-row--selected\" title=\"unused · 3 weeks\"><div class=\"kanso-content__primary\"><span class=\"kanso-text--muted\">node:20-bookworm</span><span class=\"kanso-panel__row-value kanso-text--muted\">1.1 GB</span></div><div style=\"display:flex;gap:var(--k-sp-2);align-items:center;margin-top:var(--k-sp-2)\"><div class=\"kanso-field kanso-control--focus\">web<span class=\"kanso-panel__caret\"></span></div><div class=\"kanso-field\">8080:80</div><span class=\"kanso-button\" style=\"height:26px\">Run</span></div></div>\n              <div class=\"kanso-section\">Volumes<span class=\"kanso-button--quiet\">Remove 2 unused</span></div>\n              <div class=\"kanso-row\">mailpit-data<span class=\"kanso-row__meta\">acme-shop · mailpit</span></div>\n              <div class=\"kanso-row\"><span class=\"kanso-text--muted\">pg-old</span><span class=\"kanso-row__meta\">unused</span></div>\n              <div class=\"kanso-section\">Build cache<span class=\"kanso-button--quiet\">Clear 860 MB</span></div>\n            </div></div></div>",
