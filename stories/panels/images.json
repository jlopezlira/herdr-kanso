  "spec": [
   [
    "Anatomy",
    "the panel as the app draws it: header, scope, body from the kit primitives\nstate: A read failed"
   ],
   [
    "Values",
    "panel 368 wide · padding 16 · rows 32 · meta 11.5 dim\nonly kit tokens; no colour but the marks"
   ],
   [
    "States",
    "A read failed"
   ],
   [
    "Behaviour",
