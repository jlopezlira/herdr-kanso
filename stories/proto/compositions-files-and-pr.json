  "caption": "A review comment quotes three lines, the one it talks about on w7.",
  "html": "<div class=\"st-ex\"><div class=\"k st-s panel\"><div class=\"panel\" style=\"height:auto\"><div class=\"pax-snip\"><div class=\"pax-dl\"><span class=\"n\">11</span><span class=\"s\"> </span>export function bucket(customer) {</div><div class=\"pax-dl on\"><span class=\"n\">12</span><span class=\"s\"> </span>  const plan = planOf(customer);</div><div class=\"pax-dl\"><span class=\"n\">13</span><span class=\"s\"> </span>  return { plan, tokens: LIMIT[plan] };</div></div></div></div></div>"
